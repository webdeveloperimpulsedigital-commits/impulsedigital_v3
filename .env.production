# ── Production Environment Variables ─────────────────────────────────
# This file is committed to Git for non-secret production defaults only.
# Configure every password, token, key, and secret in Hostinger's
# Environment Variables panel.

# Required at runtime and already configured in Hostinger.
# ADMIN_PASSWORD=

# ── AE (UAE) Blog WordPress REST API ────────────────────────────────
# Update this in Hostinger hPanel if the AE WordPress origin changes.
AE_WP_API=https://impulsedigital.co.in/ae/blog/wp-json/wp/v2
